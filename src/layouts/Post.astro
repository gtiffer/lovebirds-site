---
// One blog post: title, byline, body, questions, the closing line with the
// App Store button, and who wrote it. Adds the post's structured data.
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import authors from '../data/authors.json';
import { SITE, absolute } from '../data/site';

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, hero, heroAlt, faq, howToSteps, cta } = post.data;
const author = authors[post.data.author as keyof typeof authors];
const path = `/blog/${post.id}/`;
const day = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);

const publisher = {
  '@type': 'Organization', name: SITE.name, url: absolute('/'),
  logo: { '@type': 'ImageObject', url: absolute('/assets/apple-touch-icon.png') },
};
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: title, description,
    image: absolute(hero ?? SITE.ogImage),
    datePublished: iso(pubDate), dateModified: iso(updatedDate ?? pubDate),
    author: { '@type': 'Person', name: author.name, description: author.bio },
    publisher, mainEntityOfPage: absolute(path),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: absolute('/blog/') },
      { '@type': 'ListItem', position: 3, name: title, item: absolute(path) },
    ],
  },
];
if (faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  });
}
if (howToSteps?.length) {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'HowTo', name: title,
    step: howToSteps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  });
}
---
<Base
  title={title}
  description={description}
  path={path}
  ogType="article"
  ogImage={hero}
  ogImageAlt={hero ? heroAlt : undefined}
  mainClass="prose post"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={iso(pubDate)}>
    {updatedDate && <meta property="article:modified_time" content={iso(updatedDate)}>}
  </Fragment>

  <a href="/"><img class="wordmark" src="/assets/art/wordmark.png" alt="Love Birds" width="182" height="34"></a>
  <a class="label crumb" href="/blog/">Blog</a>

  <article>
    <h1>{title}</h1>
    <p class="label byline">
      By {author.name} · <time datetime={iso(pubDate)}>{day(pubDate)}</time>
      {updatedDate && <> · Updated <time datetime={iso(updatedDate)}>{day(updatedDate)}</time></>}
    </p>

    {hero && <img class="hero" src={hero} alt={heroAlt} width="1200" height="630">}

    <slot />

    {faq?.length && (
      <section class="faq">
        <h2>Questions</h2>
        {faq.map(({ q, a }) => (
          <>
            <h3>{q}</h3>
            <p>{a}</p>
          </>
        ))}
      </section>
    )}

    <section class="cta">
      <p>{cta}</p>
      <div class="actions">
        <a class="btn notched" data-get data-campaign={`blog-${post.id}`} href="#">Get Love Birds</a>
        <p class="note soon" hidden>Love Birds is coming soon to the App Store.</p>
      </div>
    </section>

    <aside class="author">
      <p class="label bold">{author.name}</p>
      <p>{author.bio}</p>
    </aside>
  </article>
</Base>
