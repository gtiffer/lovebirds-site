---
// The list of posts, newest first. Until the first post goes up it says so and
// stays out of search results.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const day = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="The Love Birds Blog"
  description="Little ideas for writing to your partner and staying close, from the makers of Love Birds."
  path="/blog/"
  noindex={posts.length === 0}
  mainClass="prose"
>
  <a href="/"><img class="wordmark" src="/assets/art/wordmark.png" alt="Love Birds" width="182" height="34"></a>
  <h1>The Love Birds Blog</h1>
  <p>Little ideas for writing to your partner and staying close.</p>

  {posts.length === 0 && <p class="label">The first letters are on their way.</p>}

  <ul class="posts">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <p>{post.data.description}</p>
        <p class="label"><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{day(post.data.pubDate)}</time></p>
      </li>
    ))}
  </ul>
</Base>
