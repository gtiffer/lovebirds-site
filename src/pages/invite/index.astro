---
// The page a partner lands on from an invite link: /invite#c=CODE&n=NAME.
// What Messages shows as the link preview is the same for every invite: the
// sender's name and code live after the # and never reach this server.
import Base from '../../layouts/Base.astro';
import Scene from '../../components/Scene.astro';
---
<Base
  title="You've been sent a love bird"
  description="Love notes, carried by birds. Get Love Birds to open it."
  path="/invite/"
  noindex
  footer={[{ href: '/', label: 'Love Birds' }, { href: '/privacy/', label: 'Privacy' }]}
>
  <img class="wordmark" src="/assets/art/wordmark.png" alt="Love Birds" width="182" height="34">

  <Scene />

  <h1 id="title">Someone sent you a love bird.</h1>
  <p class="line" id="line">It's circling until you join.</p>

  <div id="code-block" hidden>
    <div class="tiles" id="tiles" role="img"></div>
    <button class="chip label bold notched" id="copy" type="button">Copy code</button>
  </div>

  <div class="actions">
    <a class="btn notched" data-get href="#">Get Love Birds</a>
    <p class="note" id="soon" hidden>Love Birds is coming soon to the App Store.</p>
    <p class="label" id="then">Then open it and enter the code</p>
    <a class="label bold quiet" id="open" href="lovebirds://pair">Already have Love Birds? Open it</a>
  </div>

  <script is:inline slot="end">
    (function () {
      // Same alphabet as PairingCode in the app: no look-alike characters.
      const ALPHABET = "ACDEFGHJKMNPQRTUVWXYZ2346789";

      // Links look like /invite#c=42MPNQ&n=Gustavo
      const params = new URLSearchParams(location.hash.slice(1));
      const code = (params.get("c") || "").toUpperCase().split("").filter((ch) => ALPHABET.includes(ch)).join("").slice(0, 6);
      const name = (params.get("n") || "").replace(/\s+/g, " ").trim().slice(0, 40);

      const title = document.getElementById("title");
      const line = document.getElementById("line");

      if (code.length !== 6) {
        title.textContent = "A love bird is on its way.";
        line.textContent = "This invite link looks incomplete. Ask your partner to send it again.";
        document.getElementById("then").hidden = true;
        document.getElementById("open").href = "lovebirds://open";
        return;
      }

      const sender = name || "Someone";
      title.textContent = `${sender} sent you a love bird.`;
      document.title = `${sender} sent you a love bird`;

      const tiles = document.getElementById("tiles");
      tiles.setAttribute("aria-label", `Invite code ${code.split("").join(" ")}`);
      for (const ch of code) {
        const tile = document.createElement("div");
        tile.className = "tile notched";
        tile.textContent = ch;
        tiles.appendChild(tile);
      }
      document.getElementById("code-block").hidden = false;
      document.getElementById("open").href = `lovebirds://pair/${code}`;

      const copy = document.getElementById("copy");
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code);
          copy.textContent = "Copied";
        } catch {
          copy.textContent = code;
        }
        setTimeout(() => { copy.textContent = "Copy code"; }, 2000);
      });
    })();
  </script>
</Base>
